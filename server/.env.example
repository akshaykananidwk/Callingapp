# ---- CallBridge server configuration ----
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://test.akdwk.in

# PostgreSQL
DATABASE_URL=postgres://callbridge:CHANGE_ME@127.0.0.1:5432/callbridge

# Speech-to-text: whisper_cpp | openai | none
STT_PROVIDER=whisper_cpp
WHISPER_URL=http://127.0.0.1:8765/inference
# Only when STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# Default language when the phone sends "auto": auto | gu | hi | en
DEFAULT_LANGUAGE=auto
# Seconds of audio per transcription chunk (lower = faster text, less accurate)
CHUNK_SECONDS=5
